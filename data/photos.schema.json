{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "photos.schema.json",
  "title": "M Beauty Road archive",
  "type": "object",
  "required": ["schemaVersion", "updatedAt", "entries"],
  "properties": {
    "schemaVersion": {"const": 2},
    "updatedAt": {"type": "string", "format": "date-time"},
    "profile": {"type": "object"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "capturedAt", "importedAt", "photos"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "capturedAt": {"type": ["string", "null"], "format": "date-time"},
          "sourceTime": {"type": ["string", "null"], "format": "date-time"},
          "importedAt": {"type": "string", "format": "date-time"},
          "cover": {"type": "string", "pattern": "^assets/photos/"},
          "coverThumb": {"type": "string", "pattern": "^assets/photos/"},
          "coverIndex": {"type": "integer", "minimum": 0},
          "photos": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["src", "thumb", "alt", "caption"],
              "properties": {
                "src": {"type": "string", "pattern": "^assets/photos/"},
                "thumb": {"type": "string", "pattern": "^assets/photos/"},
                "alt": {"type": "string"},
                "caption": {"type": "string"},
                "width": {"type": "integer", "minimum": 1},
                "height": {"type": "integer", "minimum": 1}
              }
            }
          }
        }
      }
    }
  }
}
